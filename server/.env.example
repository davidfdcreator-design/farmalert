# Database (Supabase connection string oppure Postgres locale)
DATABASE_URL="postgresql://user:password@host:5432/farmalert"

# Password condivisa per accedere all'app da tutti i dispositivi
APP_PASSWORD="cambia-questa-password"

# JWT secret per firmare i token (genera una stringa lunga e casuale)
JWT_SECRET="cambia-questo-secret-con-una-stringa-lunga-e-casuale"

# VAPID keys per Web Push (genera con: npm run vapid:keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:tua@email.it"

# Origine consentita per CORS (frontend GitHub Pages)
CLIENT_URL="http://localhost:5173"

# Porta del server
PORT=3000
